@startuml db_improved

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam backgroundColor transparent
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 80
skinparam ranksep 80

skinparam class {
  BackgroundColor #F5F5F5
  BorderColor #444444
  HeaderBackgroundColor #D0E4F0
  FontColor #222222
  AttributeFontColor #333333
  ArrowColor #444444
  ArrowFontSize 11
  ArrowFontColor #555555
}

' ──────────────────────────────────────────
' Core
' ──────────────────────────────────────────

entity SCANNER_RUNS {
  * id               : INTEGER <<PK>>
  --
    started_at       : TIMESTAMP
    finished_at      : TIMESTAMP
    scanner_version  : TEXT
}

entity ORGANISATIONS {
  * id               : INTEGER <<PK>>
  --
    name             : TEXT
    wikidata_url     : TEXT
    primary_domain   : TEXT
    email_domain     : TEXT
    website_domain   : TEXT
    website          : TEXT
    city             : TEXT
    state            : TEXT
    country          : TEXT
    category_tag     : TEXT
    longitude        : REAL
    latitude         : REAL
}

entity IP_ADDRESSES {
  * id               : INTEGER <<PK>>
  --
    ip_address       : TEXT
    rdns_hostname    : TEXT
    asn              : INTEGER
    asn_org          : TEXT
    country_code     : TEXT
    rating           : INTEGER
}

' ──────────────────────────────────────────
' Mail Systems
' ──────────────────────────────────────────

entity MAIL_SYSTEMS {
  * id                  : INTEGER <<PK>>
  --
  * role                : ENUM('smtp_out','smtp_in','imap_pop3','webmailer', 'proxy')
  * software            : TEXT
    vendor              : TEXT
    is_open_source      : INTEGER
    provider_category   : TEXT
    rating              : INTEGER
    --
    UNIQUE (software, role)
}

' ──────────────────────────────────────────
' History
' ──────────────────────────────────────────

entity ORG_MAIL_SYSTEM_HISTORY {
  * id               : INTEGER <<PK>>
  --
  * organisation_id  : INTEGER <<FK>>
  * mail_system_id   : INTEGER <<FK>>
  * valid_from_run   : INTEGER <<FK>>
    valid_to_run     : INTEGER <<FK>>
    proxy_system_id  : INTEGER <<FK>>
    is_current       : INTEGER
}

entity MAIL_SYSTEM_IP_HISTORY {
  * id               : INTEGER <<PK>>
  --
  * mail_system_id   : INTEGER <<FK>>
  * ip_address_id    : INTEGER <<FK>>
  * valid_from_run   : INTEGER <<FK>>
    valid_to_run     : INTEGER <<FK>>
    is_current       : INTEGER
}

' ──────────────────────────────────────────
' Relations
' ──────────────────────────────────────────

ORGANISATIONS       "1" --- "0..*"  ORG_MAIL_SYSTEM_HISTORY   : has >
MAIL_SYSTEMS        "1" --- "0..*"  ORG_MAIL_SYSTEM_HISTORY   : proxy for >
MAIL_SYSTEMS        "1" --- "0..*"  ORG_MAIL_SYSTEM_HISTORY   : referenced in >
SCANNER_RUNS        "1" --- "0..*"  ORG_MAIL_SYSTEM_HISTORY   : valid_from / valid_to >

MAIL_SYSTEMS        "1" --- "0..*"  MAIL_SYSTEM_IP_HISTORY    : has >
IP_ADDRESSES        "1" --- "0..*"  MAIL_SYSTEM_IP_HISTORY    : referenced in >
SCANNER_RUNS        "1" --- "0..*"  MAIL_SYSTEM_IP_HISTORY    : valid_from / valid_to >

@enduml
